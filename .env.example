# Required for manual/Docker launches. Windows launcher generates a local secret automatically.
MEMORYGUARD_SECRET=replace-with-a-long-random-secret

# Optional ordinary runtime API key for localhost-only desktop use; REQUIRED if binding beyond localhost or using the hardened Docker compose.
# MEMORYGUARD_API_KEY=use-a-different-long-random-secret

# Required for manual/Docker server startup. Keep this separate from the ordinary API key and out of runtime-agent configuration.
MEMORYGUARD_OPERATOR_KEY=replace-with-a-different-long-random-operator-secret

# Optional database and backup paths.
# MEMORYGUARD_DB=C:\MemoryGuard\memoryguard.db
# MEMORYGUARD_BACKUP_DIR=C:\MemoryGuard\backups

# Optional listener settings. Defaults: 127.0.0.1 and uncommon high port 43847.
# MEMORYGUARD_HOST=127.0.0.1
# MEMORYGUARD_PORT=43847

# Optional paid entitlement file.
# MEMORYGUARD_LICENSE_FILE=C:\secure\license.mglic

# Optional installation identifier used only when a licence is explicitly bound to one.
# MEMORYGUARD_INSTALLATION_ID=install_random_value

# Optional replacement public verification key for production licensing.
# MEMORYGUARD_LICENSE_PUBLIC_KEY_FILE=C:\secure\memoryguard_license_public_key.pem
